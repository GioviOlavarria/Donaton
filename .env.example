# Variables de entorno para Donaton

# ==========================================
# CONFIGURACIÓN GENERAL
# ==========================================
COMPOSE_PROJECT_NAME=donaton

# ==========================================
# CONFIGURACIÓN DE MYSQL
# ==========================================
MYSQL_ROOT_PASSWORD=rootpassword

# Base de datos de Donantes
DONANTES_DB_NAME=donaton_donantes
DONANTES_DB_USER=usuario
DONANTES_DB_PASSWORD=password123
DONANTES_DB_PORT=3301
DONANTES_APP_PORT=8081

# Base de datos de Beneficiarios
BENEFICIARIOS_DB_NAME=donaton_beneficiarios
BENEFICIARIOS_DB_USER=usuario
BENEFICIARIOS_DB_PASSWORD=password123
BENEFICIARIOS_DB_PORT=3302
BENEFICIARIOS_APP_PORT=8082

# Base de datos de Centros de Acopio
CENTROS_DB_NAME=donaton_centros
CENTROS_DB_USER=usuario
CENTROS_DB_PASSWORD=password123
CENTROS_DB_PORT=3303
CENTROS_APP_PORT=8083

# Base de datos de Donaciones
DONACIONES_DB_NAME=donaton_donaciones
DONACIONES_DB_USER=usuario
DONACIONES_DB_PASSWORD=password123
DONACIONES_DB_PORT=3304
DONACIONES_APP_PORT=8084

# Base de datos de Comunas
COMUNAS_DB_NAME=donaton_comunas
COMUNAS_DB_USER=usuario
COMUNAS_DB_PASSWORD=password123
COMUNAS_DB_PORT=3305
COMUNAS_APP_PORT=8085

# Base de datos de Tipos
TIPOS_DB_NAME=donaton_tipos
TIPOS_DB_USER=usuario
TIPOS_DB_PASSWORD=password123
TIPOS_DB_PORT=3306
TIPOS_APP_PORT=8086

# Base de datos de Autenticación
AUTH_DB_NAME=donaton_auth
AUTH_DB_USER=usuario
AUTH_DB_PASSWORD=password123
AUTH_DB_PORT=3310
AUTH_APP_PORT=8087

# ==========================================
# CONFIGURACIÓN DE ADMIN
# ==========================================
ADMIN_APP_PORT=8088

# URLs de servicios (para uso interno en Docker)
SVC_DONANTES=http://ms-donantes:8081
SVC_BENEFICIARIOS=http://ms-beneficiarios:8082
SVC_CENTROS=http://ms-centros-acopio:8083
SVC_DONACIONES=http://ms-donaciones:8084
SVC_COMUNAS=http://ms-comunas:8085
SVC_TIPOS=http://ms-tipos:8086
SVC_AUTH=http://ms-auth:8087

# URLs públicas (accesibles desde el navegador)
PUB_DONANTES=http://localhost:8081
PUB_BENEFICIARIOS=http://localhost:8082
PUB_CENTROS=http://localhost:8083
PUB_DONACIONES=http://localhost:8084
PUB_COMUNAS=http://localhost:8085
PUB_TIPOS=http://localhost:8086
PUB_AUTH=http://localhost:8087

# ==========================================
# CONFIGURACIÓN JWT
# ==========================================
DONATON_JWT_SECRET=donaton_super_secret_key_2026_rm_santiago
DONATON_JWT_EXPIRATION_MS=86400000

# ==========================================
# CONFIGURACIÓN DE LOGGING
# ==========================================
LOG_LEVEL=INFO

